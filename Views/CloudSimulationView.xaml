<UserControl x:Class="Grimmcair.Desktop.Views.CloudSimulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Theme.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="11,7" /><Setter Property="MinHeight" Value="34" />
            </Style>
            <Style x:Key="SmallLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="云存档" Style="{StaticResource PageTitle}" /><TextBlock Text="按角色管理主副档，预览主档的材料需求。" Style="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Center" Background="#E5CCA2" CornerRadius="5" Padding="12,8"><TextBlock Text="本地模拟 · 不连接服务器" FontWeight="SemiBold" /></Border>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource PaperPanel}" Padding="14,11" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="本地模拟账户" FontWeight="SemiBold" /><TextBlock Text="仅管理自己的存档" Style="{StaticResource MutedText}" /></StackPanel>
                <Grid Grid.Column="1" Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Text="徽章等级" Style="{StaticResource SmallLabel}" /><ComboBox x:Name="BadgeBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Level" SelectionChanged="BadgeBox_SelectionChanged" AutomationProperties.Name="模拟冒险家徽章等级" />
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock x:Name="CapacityText" FontWeight="SemiBold" /><TextBlock Text="云槽位 24＋等级×2" Style="{StaticResource MutedText}" /></StackPanel>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,9,0,0">
                    <CheckBox x:Name="OfflineBox" Content="模拟离线" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" Margin="0,0,12,4" />
                    <Button x:Name="SyncAccountButton" Content="同步我的存档" Style="{StaticResource PrimaryButton}" Padding="12,7" MinHeight="34" Click="SyncAccount_Click" Margin="0,0,0,4" />
                </WrapPanel>
            </Grid>
        </Border>
        <Grid x:Name="SavesPage" Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="245" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1.65*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PaperPanel}" Padding="12">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="SaveCountText" Style="{StaticResource SectionLabel}" Text="我的本地分档" Margin="6,0,0,7" />
                        <ListBox x:Name="SlotList" Grid.Row="1" SelectionChanged="SlotList_SelectionChanged" AutomationProperties.Name="角色分档列表">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                <TextBlock Text="{Binding CharacterLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Name}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Badges}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding SyncLabel}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2" Text="先在“我的存档”导入角色，或加载演示。每个游戏账号＋职业只有一个主档。" Style="{StaticResource MutedText}" Margin="6,10,6,0" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PaperPanel}" Padding="18,14">
                    <Grid>
                        <TextBlock x:Name="EmptySaveText" Text="选择左侧存档，查看主副档和装备目标。" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <ScrollViewer x:Name="SaveDetailScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,7,0">
                            <StackPanel>
                                <TextBlock x:Name="DetailCharacterText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailSaveText" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                <TextBlock x:Name="DetailSyncText" Style="{StaticResource MutedText}" Margin="0,3,0,9" />
                                <WrapPanel>
                                    <Button Content="复制为副档" Style="{StaticResource CompactButton}" Click="DuplicateSave_Click" Margin="0,0,8,7" />
                                    <Button x:Name="MakeMainButton" Content="设为主档" Style="{StaticResource CompactButton}" Click="MakeMain_Click" Margin="0,0,8,7" />
                                    <CheckBox x:Name="SyncEnabledBox" Content="选择云同步" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" Click="SyncEnabled_Click" Margin="0,0,0,7" />
                                </WrapPanel>
                                <TextBlock Text="切换主档会把本角色的装备目标转交给新主档；成功同步后才更新云端快照。" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,12" />
                                <TextBlock Text="主档装备目标" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="TargetHintText" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                                <Grid x:Name="TargetEditor" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="58" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="TargetBox" DisplayMemberPath="Name" AutomationProperties.Name="主档目标装备" />
                                    <TextBox x:Name="TargetQuantityBox" Grid.Column="1" Text="1" Margin="6,0,0,0" Padding="8,6" AutomationProperties.Name="目标装备数量" />
                                    <Button Grid.Column="2" Content="设置" Click="AddTarget_Click" ToolTip="设置目标数量；相同装备再次设置会更新数量" Style="{StaticResource CompactButton}" Margin="6,0,0,0" />
                                </Grid>
                                <ItemsControl x:Name="GoalList">
                                    <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Content="移除" Tag="{Binding ItemId}" Click="RemoveTarget_Click" Style="{StaticResource CompactButton}" />
                                    </Grid></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,9,0,12" />
                                <TextBlock Text="材料缺口" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="NeedsHintText" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                                <DataGrid x:Name="NeedsGrid" MaxHeight="230" MinHeight="40" RowHeight="36" AutomationProperties.Name="主档材料缺口">
                                    <DataGrid.Columns><DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="60" /><DataGridTextColumn Header="材料" Binding="{Binding MaterialName}" Width="*" /><DataGridTextColumn Header="需用" Binding="{Binding Required}" Width="52" /><DataGridTextColumn Header="库存" Binding="{Binding Owned}" Width="52" /><DataGridTextColumn Header="缺口" Binding="{Binding Missing}" Width="52" /></DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="PendingText" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,7,0,0" />
                                <StackPanel x:Name="DemoInventoryPanel" Margin="0,14,0,0">
                                    <TextBlock Text="演示材料库存" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="仅演示档可调整，用于验证抵扣；这些配方和材料数量不代表地图实际数据。" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="70" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="InventoryBox" DisplayMemberPath="Name" SelectionChanged="InventoryBox_SelectionChanged" AutomationProperties.Name="演示库存材料" />
                                        <TextBox x:Name="InventoryQuantityBox" Grid.Column="1" Text="0" Margin="6,0,0,0" Padding="8,6" AutomationProperties.Name="演示库存数量" />
                                        <Button Grid.Column="2" Content="更新" Click="UpdateInventory_Click" Style="{StaticResource CompactButton}" Margin="6,0,0,0" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock x:Name="InventoryText" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,15,0,12" />
                                <WrapPanel>
                                    <Button x:Name="DownloadCloudButton" Content="从模拟云取回为副档" Click="DownloadCloudCopy_Click" Style="{StaticResource CompactButton}" Margin="0,0,8,7" />
                                    <Button x:Name="DeleteCloudButton" Content="删除本机模拟云副本" Click="DeleteCloudCopy_Click" Style="{StaticResource CompactButton}" Margin="0,0,0,7" />
                                </WrapPanel>
                                <TextBlock Text="取回会新建本地副档，不覆盖现有主档和目标；需要时可以再设为主档。" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                                <TextBlock Text="保留本地存档，停止该档同步并移除模拟云端记录；不删除游戏文件。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="所有操作仅保存在本机模拟文件中。" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
