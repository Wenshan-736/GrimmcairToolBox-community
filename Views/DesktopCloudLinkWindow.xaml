<Window x:Class="Grimmcair.Desktop.Views.DesktopCloudLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择同步的云档" Width="720" Height="440" MinWidth="600" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#E4D1AA"
        Foreground="#4F3523" FontFamily="Microsoft YaHei UI" FontSize="14" Icon="../Assets/logo.png">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Theme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="选择已有的同名云档" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock x:Name="LocalHeading" TextWrapping="Wrap" Margin="0,8,0,6"/>
            <TextBlock Text="多台电脑请关联同一份云档。关联会取回所选云档的最新内容，当前本地版本先保存在历史中，不增加云槽。" TextWrapping="Wrap" LineHeight="23"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PaperPanel}" Padding="12">
            <ListBox x:Name="CloudChoices" DisplayMemberPath="Label" SelectionChanged="Selection_Changed"/>
        </Border>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LinkButton" Content="关联并同步" Style="{StaticResource PrimaryButton}" Click="Link_Click" Margin="0,0,8,0"/>
            <Button Content="取消" IsCancel="True" Click="Cancel_Click" MinWidth="75"/>
        </WrapPanel>
    </Grid>
</Window>
