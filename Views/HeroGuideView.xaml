<UserControl x:Class="Grimmcair.Desktop.Views.HeroGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Grimmcair.Desktop.Views"
             xmlns:services="clr-namespace:Grimmcair.Desktop.Services"
             FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Theme.xaml" /></ResourceDictionary.MergedDictionaries>
            <services:ResourceImageConverter x:Key="GuideImage" />
            <Style x:Key="HeroHeaderPanel" TargetType="Border" BasedOn="{StaticResource PaperPanel}">
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type views:HeroGuideView}}}" Value="True"><Setter Property="Padding" Value="14,10" /><Setter Property="Margin" Value="0,0,0,8" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="HeroUnitPanel" TargetType="Border" BasedOn="{StaticResource PaperPanel}">
                <Setter Property="Padding" Value="20,11" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type views:HeroGuideView}}}" Value="True"><Setter Property="Padding" Value="14,6" /><Setter Property="Margin" Value="0,0,0,8" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="HeroSkillPanel" TargetType="Border" BasedOn="{StaticResource PaperPanel}">
                <Setter Property="Padding" Value="20,16" />
                <Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type views:HeroGuideView}}}" Value="True"><Setter Property="Padding" Value="14,10" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="HeroCompactHint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type views:HeroGuideView}}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource HeroHeaderPanel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="英雄信息" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="点击头像选择英雄" Style="{StaticResource HeroCompactHint}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="HeroPickerButton" Padding="4" Click="HeroPicker_Click" AutomationProperties.Name="选择英雄" ToolTip="点击头像选择英雄">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="76" /><Setter Property="Height" Value="76" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type views:HeroGuideView}}}" Value="True"><Setter Property="Width" Value="52" /><Setter Property="Height" Value="52" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        <Image x:Name="HeroPortrait"><Image.Style><Style TargetType="Image"><Setter Property="Width" Value="64" /><Setter Property="Height" Value="64" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type views:HeroGuideView}}}" Value="True"><Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /></DataTrigger></Style.Triggers></Style></Image.Style></Image>
                    </Button>
                    <StackPanel VerticalAlignment="Center" Margin="17,0,20,0">
                        <TextBlock x:Name="HeroNameText" Text="选择英雄" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="英雄与附属单位的技能图鉴" Style="{StaticResource HeroCompactHint}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Popup x:Name="HeroPickerPopup" PlacementTarget="{Binding ElementName=HeroPickerButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource PaperLightBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,6,0,0" Width="570">
                            <StackPanel>
                                <TextBlock Text="选择英雄" FontWeight="SemiBold" Margin="7,0,0,10" />
                                <ListBox x:Name="HeroPicker" MaxHeight="440" SelectionChanged="HeroPicker_SelectionChanged" AutomationProperties.Name="英雄列表">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="100">
                                                <Image Source="{Binding Icon, Converter={StaticResource GuideImage}}" Width="50" Height="50" />
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource HeroUnitPanel}">
            <StackPanel>
            <DockPanel>
                <TextBlock Text="单位" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <ListBox x:Name="UnitList" SelectionChanged="UnitList_SelectionChanged" AutomationProperties.Name="选择英雄单位">
                    <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Setter Property="MaxHeight" Value="130" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type views:HeroGuideView}}}" Value="True"><Setter Property="MaxHeight" Value="64" /></DataTrigger></Style.Triggers></Style></ListBox.Style>
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding OriginText}">
                                <Image Source="{Binding Icon, Converter={StaticResource GuideImage}}" Width="34" Height="34" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="230" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
                <TextBlock Text="{Binding SelectedItem.OriginText, ElementName=UnitList}" Margin="42,0,0,2">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource HeroSkillPanel}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="技能讲解" FontWeight="SemiBold" />
                    <TextBlock Text="图标下方为技能按键" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                </DockPanel>
                <views:GuideSkillPanel x:Name="SkillPanel" Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
