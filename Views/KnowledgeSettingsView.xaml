<UserControl x:Class="Grimmcair.Desktop.Views.KnowledgeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Theme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource PaperPanel}" Padding="20,16" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="本地知识库" Style="{StaticResource SectionLabel}" />
            <TextBlock Text="桌面资料与 AI 查询共用同一份知识库。配图用于查看，附带说明和来源。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock x:Name="CurrentSummary" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="CurrentSource" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,10" />
            <WrapPanel>
                <Button x:Name="ChooseButton" Content="选择资料包…" Click="Choose_Click" Margin="0,0,9,8" />
                <Button Content="恢复内置资料" Click="Builtin_Click" Margin="0,0,9,8" />
                <Button Content="查看已收录配图" Click="Images_Click" Margin="0,0,9,8" />
                <Button Content="复制 MCP 配置" Click="CopyMcp_Click" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock x:Name="SelectionStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Border>
</UserControl>
