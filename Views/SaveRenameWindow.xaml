<Window x:Class="Grimmcair.Desktop.Views.SaveRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名存档" Width="620" Height="350" MinWidth="480" MinHeight="310"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="#E4D1AA" Foreground="#4F3523" FontFamily="Microsoft YaHei UI" FontSize="13"
        Icon="../Assets/logo.png" UseLayoutRounding="True" Loaded="Window_Loaded">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Theme.xaml" /></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Style="{StaticResource PaperPanel}" Padding="18,14">
            <StackPanel>
                <TextBlock Text="重命名当前存档" FontSize="21" FontWeight="SemiBold" />
                <TextBlock x:Name="CurrentNameText" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,5,0,12" />
                <TextBlock Text="新的存档名" Margin="0,0,0,5" />
                <TextBox x:Name="NameInput" MaxLength="100" MinHeight="35" AutomationProperties.Name="新的存档名" />
                <TextBlock Text="同一角色的主副档须使用不同名字。名字用于游戏保存，最多100字；不要使用空格、横线或文件名禁用字符。"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#A23C28" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存名称" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" Margin="0,0,9,0" />
            <Button Content="取消" IsCancel="True" MinWidth="75" />
        </StackPanel>
    </Grid>
</Window>
